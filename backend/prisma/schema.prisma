generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TENANTS ───────────────────────────────────────────────────────────────
model Tenant {
  id       Int      @id @default(autoincrement())
  nombre   String
  plan     Plan     @default(STARTER)
  activo   Boolean  @default(true)
  config   Json?
  creadoEn DateTime @default(now())

  usuarios          Usuario[]
  profesionales     Profesional[]
  clientes          Cliente[]
  servicios         Servicio[]
  ordenes           Orden[]
  caja              Caja[]
  liquidaciones     Liquidacion[]
  turnos            Turno[]
  ausencias         Ausencia[]
  fichaTrabajos     FichaTrabajo[]
  vales             Vale[]
  turnosCaja        TurnoCaja[]
  nivelesPrecio     NivelPrecio[]
  metodosPagoConfig MetodoPagoConfig[]
  gastosAdmin       GastoAdmin[]

  @@map("tenants")
}

enum Plan {
  STARTER
  PRO
  CADENA
}

// ─── USUARIOS ──────────────────────────────────────────────────────────────
model Usuario {
  id       Int      @id @default(autoincrement())
  tenantId Int
  nombre   String
  email    String
  password String
  rol      Rol      @default(CAJERA)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  ordenes            Orden[]
  turnosCreados      Turno[]
  turnosCajaAbiertos TurnoCaja[] @relation("TurnoCajaAbierto")
  turnosCajaCerrados TurnoCaja[] @relation("TurnoCajaCerrado")

  @@unique([tenantId, email])
  @@map("usuarios")
}

enum Rol {
  ADMINISTRADOR
  CAJERA
  OFICINA
  ESTILISTA
  MANICURA
}

// ─── PROFESIONALES ─────────────────────────────────────────────────────────
model Profesional {
  id         Int             @id @default(autoincrement())
  tenantId   Int
  nombre     String
  apellido   String
  tipo       TipoProfesional
  porcentaje Decimal?        @db.Decimal(5, 2)
  sueldoBase Decimal?        @db.Decimal(10, 2)
  activo     Boolean         @default(true)
  creadoEn   DateTime        @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  ordenes       Orden[]
  liquidaciones Liquidacion[]
  turnos        Turno[]
  ausencias     Ausencia[]
  vales         Vale[]

  @@map("profesionales")
}

enum TipoProfesional {
  ESTILISTA
  MANICURA
  AYUDANTE
}

// ─── CLIENTES ──────────────────────────────────────────────────────────────
model Cliente {
  id           Int         @id @default(autoincrement())
  tenantId     Int
  nombre       String
  apellido     String
  telefono     String?
  email        String?
  tipoCliente  TipoCliente @default(EXISTENTE)
  recomendadoPor String?
  activo       Boolean     @default(true)
  creadoEn     DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  ordenes       Orden[]
  turnos        Turno[]
  fichaTrabajos FichaTrabajo[]

  @@map("clientes")
}

enum TipoCliente {
  EXISTENTE
  NUEVO
  RECOMENDADO
}

// ─── FICHA DE TRABAJOS ─────────────────────────────────────────────────────
model FichaTrabajo {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  clienteId        Int
  trabajoRealizado String
  estilista        String
  fecha            DateTime @db.Date
  creadoEn         DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("ficha_trabajos")
}

// ─── NIVELES DE PRECIO ─────────────────────────────────────────────────────
model NivelPrecio {
  id       Int     @id @default(autoincrement())
  tenantId Int
  nombre   String
  orden    Int     @default(0)
  activo   Boolean @default(true)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  precios           ServicioPrecio[]
  metodoPagoConfigs MetodoPagoConfig[]

  @@unique([tenantId, nombre])
  @@map("niveles_precio")
}

// ─── SERVICIOS ─────────────────────────────────────────────────────────────
model Servicio {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  nombre         String
  // TODO(paso 3 - contraer): eliminar precioEfectivo/precioTarjeta una vez
  // confirmado el backfill a ServicioPrecio.
  precioEfectivo Decimal      @db.Decimal(10, 2)
  precioTarjeta  Decimal      @db.Decimal(10, 2)
  tipo           TipoServicio
  activo         Boolean      @default(true)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  items   OrdenItem[]
  precios ServicioPrecio[]

  @@map("servicios")
}

model ServicioPrecio {
  id            Int     @id @default(autoincrement())
  servicioId    Int
  nivelPrecioId Int
  precio        Decimal @db.Decimal(10, 2)

  servicio    Servicio    @relation(fields: [servicioId], references: [id])
  nivelPrecio NivelPrecio @relation(fields: [nivelPrecioId], references: [id])

  @@unique([servicioId, nivelPrecioId])
  @@map("servicio_precios")
}

enum TipoServicio {
  PELUQUERIA
  MANICURIA
  PRODUCTO
}

// ─── ORDENES ───────────────────────────────────────────────────────────────
model Orden {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  clienteId     Int
  profesionalId Int
  usuarioId     Int
  estado        EstadoOrden @default(ABIERTA)
  fecha         DateTime    @default(now())
  observaciones String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  items       OrdenItem[]
  pagos       Pago[]

  @@map("ordenes")
}

enum EstadoOrden {
  ABIERTA
  COBRADA
  ANULADA
}

// ─── ORDEN ITEMS ───────────────────────────────────────────────────────────
model OrdenItem {
  id             Int     @id @default(autoincrement())
  ordenId        Int
  servicioId     Int?
  descripcion    String
  cantidad       Int     @default(1)
  precioAplicado Decimal @db.Decimal(10, 2)

  orden    Orden     @relation(fields: [ordenId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])

  @@map("orden_items")
}

// ─── MÉTODOS DE PAGO ───────────────────────────────────────────────────────
// TODO(paso 3 - contraer): renombrar MetodoPagoConfig -> MetodoPago una vez
// eliminado el enum legacy de abajo (choque de nombres hoy).
model MetodoPagoConfig {
  id                 Int     @id @default(autoincrement())
  tenantId           Int
  nombre             String
  nivelPrecioId      Int
  esEfectivo         Boolean @default(false)
  acreditaAlInstante Boolean @default(true)
  orden              Int     @default(0)
  activo             Boolean @default(true)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  nivelPrecio NivelPrecio @relation(fields: [nivelPrecioId], references: [id])
  pagos       Pago[]
  movimientos Caja[]

  @@unique([tenantId, nombre])
  @@map("metodos_pago")
}

// ─── PAGOS ─────────────────────────────────────────────────────────────────
model Pago {
  id           Int        @id @default(autoincrement())
  ordenId      Int
  // TODO(paso 3 - contraer): eliminar `metodo` (legacy) una vez confirmado
  // el backfill de metodoPagoId, y volver este campo NOT NULL.
  metodo       MetodoPago
  metodoPagoId Int?
  monto        Decimal    @db.Decimal(10, 2)
  acreditado   Boolean    @default(true)
  fecha        DateTime   @default(now())

  orden      Orden             @relation(fields: [ordenId], references: [id])
  metodoPago MetodoPagoConfig? @relation(fields: [metodoPagoId], references: [id])

  @@map("pagos")
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MERCADO_PAGO
}

// ─── CAJA ──────────────────────────────────────────────────────────────────
model Caja {
  id           Int        @id @default(autoincrement())
  tenantId     Int
  tipo         TipoCaja
  // TODO(paso 3 - contraer): eliminar `metodo` (legacy) una vez confirmado
  // el backfill de metodoPagoId, y volver este campo NOT NULL.
  metodo       MetodoPago
  metodoPagoId Int?
  monto        Decimal    @db.Decimal(10, 2)
  concepto     String
  referenciaId Int?
  fecha        DateTime   @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  metodoPago MetodoPagoConfig? @relation(fields: [metodoPagoId], references: [id])

  @@map("caja")
}

enum TipoCaja {
  INGRESO
  EGRESO
}

// ─── LIQUIDACIONES ─────────────────────────────────────────────────────────
model Liquidacion {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  profesionalId  Int
  periodo        String
  produccion     Decimal  @db.Decimal(10, 2)
  comision       Decimal  @db.Decimal(10, 2)
  sueldoBase     Decimal  @default(0) @db.Decimal(10, 2)
  adelantos      Decimal  @default(0) @db.Decimal(10, 2)
  vales          Decimal  @default(0) @db.Decimal(10, 2)
  cargasSociales Decimal  @default(0) @db.Decimal(10, 2)
  descuentos     Decimal  @default(0) @db.Decimal(10, 2)
  otros          Decimal  @default(0) @db.Decimal(10, 2)
  notas          String?
  sueldoNeto     Decimal  @db.Decimal(10, 2)
  aprobada       Boolean  @default(false)
  creadoEn       DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([profesionalId, periodo])
  @@map("liquidaciones")
}

// ─── TURNOS ────────────────────────────────────────────────────────────────
model Turno {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  clienteId     Int
  profesionalId Int
  fecha         DateTime    @db.Date
  hora          String
  servicios     String
  observaciones String?
  estado        EstadoTurno @default(PENDIENTE)
  creadoPor     Int
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])
  usuario     Usuario     @relation(fields: [creadoPor], references: [id])

  @@map("turnos")
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  ARCHIVADO
}

model Ausencia {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  profesionalId Int
  fecha         DateTime @db.Date
  motivo        String?
  creadoEn      DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([profesionalId, fecha])
  @@map("ausencias")
}

// ─── VALES ─────────────────────────────────────────────────────────────────
model Vale {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  profesionalId Int
  monto         Decimal  @db.Decimal(10, 2)
  concepto      String?
  fecha         DateTime @default(now())
  periodo       String
  descontado    Boolean  @default(false)
  creadoEn      DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@map("vales")
}

// ─── GASTOS ADMINISTRATIVOS (fuera de planilla) ───────────────────────────
model GastoAdmin {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  descripcion String
  monto       Decimal  @db.Decimal(10, 2)
  periodo     String
  fecha       DateTime @default(now())
  creadoPor   Int

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("gastos_admin")
}

// ─── CIERRE DE TURNO DE CAJA ────────────────────────────────────────────────
model TurnoCaja {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  tipo            TipoTurno
  fecha           DateTime        @db.Date
  cajera          String
  fondoCambio     Decimal         @db.Decimal(10, 2)
  estado          EstadoTurnoCaja @default(ABIERTO)
  efectivoContado Decimal?        @db.Decimal(10, 2)
  diferencia      Decimal?        @db.Decimal(10, 2)
  observaciones   String?
  abiertoPor      Int
  cerradoPor      Int?
  abiertaEn       DateTime        @default(now())
  cerradaEn       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  abridor  Usuario  @relation("TurnoCajaAbierto", fields: [abiertoPor], references: [id])
  cerrador Usuario? @relation("TurnoCajaCerrado", fields: [cerradoPor], references: [id])

  @@map("turnos_caja")
}

enum TipoTurno {
  MANIANA
  TARDE
}

enum EstadoTurnoCaja {
  ABIERTO
  CERRADO
}
