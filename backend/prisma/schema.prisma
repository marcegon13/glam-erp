generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TENANTS ───────────────────────────────────────────────────────────────
model Tenant {
  id          Int      @id @default(autoincrement())
  nombre      String
  plan        Plan     @default(STARTER)
  activo      Boolean  @default(true)
  config      Json?
  creadoEn    DateTime @default(now())

  usuarios      Usuario[]
  profesionales Profesional[]
  clientes      Cliente[]
  servicios     Servicio[]
  ordenes       Orden[]
  caja          Caja[]
  liquidaciones Liquidacion[]

  @@map("tenants")
}

enum Plan {
  STARTER
  PRO
  CADENA
}

// ─── USUARIOS ──────────────────────────────────────────────────────────────
model Usuario {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  nombre     String
  email      String
  password   String
  rol        Rol      @default(CAJERA)
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  ordenes Orden[]

  @@unique([tenantId, email])
  @@map("usuarios")
}

enum Rol {
  ADMINISTRADOR
  CAJERA
  OFICINA
  ESTILISTA
  MANICURA
}

// ─── PROFESIONALES ─────────────────────────────────────────────────────────
model Profesional {
  id            Int              @id @default(autoincrement())
  tenantId      Int
  nombre        String
  apellido      String
  tipo          TipoProfesional
  porcentaje    Decimal?         @db.Decimal(5, 2)
  sueldoBase    Decimal?         @db.Decimal(10, 2)
  activo        Boolean          @default(true)
  creadoEn      DateTime         @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  ordenes       Orden[]
  liquidaciones Liquidacion[]

  @@map("profesionales")
}

enum TipoProfesional {
  ESTILISTA
  MANICURA
  AYUDANTE
}

// ─── CLIENTES ──────────────────────────────────────────────────────────────
model Cliente {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  nombre     String
  apellido   String
  telefono   String?
  email      String?
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  ordenes Orden[]

  @@map("clientes")
}

// ─── SERVICIOS ─────────────────────────────────────────────────────────────
model Servicio {
  id         Int             @id @default(autoincrement())
  tenantId   Int
  nombre     String
  precio     Decimal         @db.Decimal(10, 2)
  tipo       TipoServicio
  activo     Boolean         @default(true)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  items  OrdenItem[]

  @@map("servicios")
}

enum TipoServicio {
  ESTILISTA
  MANICURA
  GENERAL
}

// ─── ORDENES ───────────────────────────────────────────────────────────────
model Orden {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  clienteId     Int
  profesionalId Int
  usuarioId     Int
  estado        EstadoOrden  @default(ABIERTA)
  fecha         DateTime     @default(now())
  observaciones String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  items       OrdenItem[]
  pagos       Pago[]

  @@map("ordenes")
}

enum EstadoOrden {
  ABIERTA
  COBRADA
  ANULADA
}

// ─── ORDEN ITEMS ───────────────────────────────────────────────────────────
model OrdenItem {
  id             Int     @id @default(autoincrement())
  ordenId        Int
  servicioId     Int?
  descripcion    String
  precioAplicado Decimal @db.Decimal(10, 2)

  orden    Orden     @relation(fields: [ordenId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])

  @@map("orden_items")
}

// ─── PAGOS ─────────────────────────────────────────────────────────────────
model Pago {
  id          Int          @id @default(autoincrement())
  ordenId     Int
  metodo      MetodoPago
  monto       Decimal      @db.Decimal(10, 2)
  fecha       DateTime     @default(now())

  orden Orden @relation(fields: [ordenId], references: [id])

  @@map("pagos")
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// ─── CAJA ──────────────────────────────────────────────────────────────────
model Caja {
  id          Int        @id @default(autoincrement())
  tenantId    Int
  tipo        TipoCaja
  metodo      MetodoPago
  monto       Decimal    @db.Decimal(10, 2)
  concepto    String
  referenciaId Int?
  fecha       DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("caja")
}

enum TipoCaja {
  INGRESO
  EGRESO
}

// ─── LIQUIDACIONES ─────────────────────────────────────────────────────────
model Liquidacion {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  profesionalId Int
  periodo       String
  produccion    Decimal  @db.Decimal(10, 2)
  comision      Decimal  @db.Decimal(10, 2)
  sueldoBase    Decimal  @db.Decimal(10, 2)
  adelantos     Decimal  @db.Decimal(10, 2) @default(0)
  descuentos    Decimal  @db.Decimal(10, 2) @default(0)
  sueldoNeto    Decimal  @db.Decimal(10, 2)
  aprobada      Boolean  @default(false)
  creadoEn      DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([profesionalId, periodo])
  @@map("liquidaciones")
}
